# Copy to .env and fill in only what you use (or run `leadhunter setup`). Never commit .env.

# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=

# AI (pick one, free tiers available)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Web search (pick one)
BRAVE_API_KEY=
TAVILY_API_KEY=

# Optional email finder
HUNTER_API_KEY=

# Optional Reddit r/forhire leads (create a free "script" app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional Telegram alert when someone replies (bot from @BotFather; the chat ID is found for you in setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
